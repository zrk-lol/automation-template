{
  "name": "automation-template",
  "version": "1.0.0",
  "description": "Automation starter: scheduled uptime checks and reports, Discord alerts, GitHub Actions cron.",
  "type": "module",
  "license": "MIT",
  "author": "Varhex by Ȥrk Team",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsx --env-file-if-exists=.env src/index.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
